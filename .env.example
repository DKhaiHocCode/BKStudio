# Copy to .env and adjust. Never commit .env. Values below are dev-only placeholders.

# PostgreSQL
POSTGRES_DB=bkstudio
POSTGRES_USER=bkstudio
POSTGRES_PASSWORD=change-me-dev
POSTGRES_PORT=5432

# MinIO (local stand-in for Cloudflare R2, S3-compatible)
MINIO_ROOT_USER=bkstudio
MINIO_ROOT_PASSWORD=change-me-dev-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
R2_BUCKET=bkstudio-dev

# Public base URL of product images (no trailing slash); dev default matches the MinIO bucket above
R2_PUBLIC_BASE_URL=http://localhost:9000/bkstudio-dev

# Prod only (Cloudflare R2); dev uses the MINIO_* values above as storage credentials
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto

# Admin auth (T-012). No real values here.
# TOTP_ENCRYPTION_KEY = base64 of 32 random bytes (required in prod). Generate with PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# TOTP_ENCRYPTION_KEY=
# The one-off create-admin CLI reads ADMIN_INITIAL_PASSWORD from the shell only (docs/DEPLOYMENT.md section 8); never put it here.

# Public base URL of the shop; used for order links in API responses/emails (T-022). Prod must be https://.
# APP_BASE_URL=http://localhost:3000

# Email (T-024). Prod only; without RESEND_API_KEY emails are only logged. MAIL_FROM e.g. BKStudio <orders@your-domain>
# RESEND_API_KEY=
# MAIL_FROM=

# Reverse proxy / client IP (T-040/T-042). Prod: native + the Caddy container address (fixed ipv4_address, /32 CIDR). Never expose the backend port.
# infra/docker-compose.yml already sets both (tied to its fixed network); only set them when running the jar yourself.
# FORWARD_HEADERS_STRATEGY=native
# TRUSTED_PROXIES=172.30.0.10/32
# Caddy (infra/Caddyfile). SITE_ADDRESS=domain in prod; CDN_ORIGIN=origin of R2_PUBLIC_BASE_URL (required in prod).
# SITE_ADDRESS=:80
# CDN_ORIGIN=https://cdn.example.com
# Only for running Caddy outside compose; infra/docker-compose.yml sets backend:8080 / frontend:3000.
# BACKEND_UPSTREAM=backend:8080
# FRONTEND_UPSTREAM=frontend:3000

# Abuse limits (T-047). Optional: infra/docker-compose.yml passes these with the defaults shown (same as application.yml).
# The email limit counts orders per canonical address (lower case, +tag stripped). Durations use Spring format (1h, 30m).
# APP_CHECKOUT_RATE_LIMIT_MAX=5
# APP_CHECKOUT_RATE_LIMIT_WINDOW=1h
# APP_CHECKOUT_EMAIL_LIMIT_MAX=3
# APP_CHECKOUT_EMAIL_LIMIT_WINDOW=1h
# Emails per rolling 24 h (Resend free plan: 100/day); the rest stays PENDING.
# APP_NOTIFICATION_OUTBOX_DAILY_CAP=80

# Production compose (T-042, infra/docker-compose.yml)
# Public origin of the shop, inlined into the frontend image at build time (canonical URLs, sitemap).
# NEXT_PUBLIC_SITE_URL=https://shop.example
# Cloudflare Turnstile site key (public), inlined into the frontend image at build time (T-060). Blank = no widget.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key (backend only, secret). Required by infra/docker-compose.yml and by profile prod (Cloudflare
# test secrets are refused there). Blank in dev = captcha off. Setup: docs/DEPLOYMENT.md section 3.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY above is required by infra/docker-compose.yml as well.
# TURNSTILE_SECRET_KEY=
# Host ports published by Caddy (defaults 80/443; change only on a dev machine where they are taken).
# HTTP_PORT=80
# HTTPS_PORT=443
# Tag of the locally built images bkstudio-backend / bkstudio-frontend / bkstudio-backup (default "local").
# IMAGE_TAG=local

# Database backup (T-044, docs/DEPLOYMENT.md section 4). Prod: required by infra/docker-compose.yml.
# Separate private R2 bucket (R2_ENDPOINT is reused). R2 has no write-only token: use Object Read & Write scoped to
# this bucket only, plus a bucket lock rule so this key cannot delete or overwrite recent backups (DEPLOYMENT.md section 4).
# R2_BACKUP_BUCKET=
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
# gpg passphrase, e.g. openssl rand -hex 32. Keep a copy in the password manager: without it backups are useless.
# BACKUP_ENCRYPTION_PASSPHRASE=
# Healthchecks.io-style ping URL (ADR-0013). Treat as a secret. Unset = no alert when a backup fails or does not run.
# BACKUP_HEALTHCHECK_URL=
# All backup values: hex or base64url only (no quotes, backslash or $): the scripts put them inside a quoted curl
# config line, and compose treats $ as a variable.
# Read key for restores (Object Read ONLY on the backup bucket): never in the VPS .env, only in the operator's shell
# during a restore (docs/DEPLOYMENT.md section 6).
# R2_BACKUP_READ_ACCESS_KEY_ID=
# R2_BACKUP_READ_SECRET_ACCESS_KEY=
