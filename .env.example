# Copy to .env and adjust. Never commit .env. Values below are dev-only placeholders.

# PostgreSQL
POSTGRES_DB=bkstudio
POSTGRES_USER=bkstudio
POSTGRES_PASSWORD=change-me-dev
POSTGRES_PORT=5432

# MinIO (local stand-in for Cloudflare R2, S3-compatible)
MINIO_ROOT_USER=bkstudio
MINIO_ROOT_PASSWORD=change-me-dev-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
R2_BUCKET=bkstudio-dev

# Public base URL of product images (no trailing slash); dev default matches the MinIO bucket above
R2_PUBLIC_BASE_URL=http://localhost:9000/bkstudio-dev

# Prod only (Cloudflare R2); dev uses the MINIO_* values above as storage credentials
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Admin auth (T-012). No real values here.
# TOTP_ENCRYPTION_KEY = base64 of 32 random bytes (required in prod). Generate with PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# TOTP_ENCRYPTION_KEY=
# Only for the one-off create-admin CLI (min 12 chars); remove it from .env afterwards.
# ADMIN_INITIAL_PASSWORD=

# Public base URL of the shop; used for order links in API responses/emails (T-022). Prod must be https://.
# APP_BASE_URL=http://localhost:3000

# Email (T-024). Prod only; without RESEND_API_KEY emails are only logged. MAIL_FROM e.g. BKStudio <orders@your-domain>
# RESEND_API_KEY=
# MAIL_FROM=
