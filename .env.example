# Copy to .env and adjust. Never commit .env. Values below are dev-only placeholders.

# PostgreSQL
POSTGRES_DB=bkstudio
POSTGRES_USER=bkstudio
POSTGRES_PASSWORD=change-me-dev
POSTGRES_PORT=5432

# MinIO (local stand-in for Cloudflare R2, S3-compatible)
MINIO_ROOT_USER=bkstudio
MINIO_ROOT_PASSWORD=change-me-dev-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
R2_BUCKET=bkstudio-dev

# Public base URL of product images (no trailing slash); dev default matches the MinIO bucket above
R2_PUBLIC_BASE_URL=http://localhost:9000/bkstudio-dev
