# Copy to .env.local (not committed). Only needed if the backend is not on localhost:8080.
BACKEND_URL=http://localhost:8080

# Public origin of the site (canonical URLs, OG tags, sitemap). Dev default http://localhost:3000.
# REQUIRED in production: `next start` and CI builds throw if unset (a plain local `next build` is exempt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
