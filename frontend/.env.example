# Copy to .env.local (not committed). Only needed if the backend is not on localhost:8080.
BACKEND_URL=http://localhost:8080

# Public origin of the site (canonical URLs, OG tags, sitemap). Dev default http://localhost:3000.
# REQUIRED in production: `next start` and CI builds throw if unset (a plain local `next build` is exempt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public) for the checkout bot check (T-060). Blank = no widget, no token sent.
# Inlined at build time. Local test with Cloudflare's dummy key (always passes): 1x00000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
